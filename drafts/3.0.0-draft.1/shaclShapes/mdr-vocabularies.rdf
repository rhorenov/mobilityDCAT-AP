    <dct:title xml:lang="en">mobilityDCAT-AP 3.0.0 SHACL Constraints - Controlled Vocabularies</dct:title>
    <dct:description xml:lang="en">Self-contained controlled-vocabulary constraints for mobilityDCAT-AP 3.0.0 (spec section 10.2). Restates the EU authority-table and mobility CV bindings rather than importing DCAT-AP's CV shapes, since that import is not 1:1. 10.2.1 MUST uses sh:node at Violation; 10.2.2/10.2.3 use the exact at-least-one-with-extras-tolerated form at Warning.</dct:description>
    <rdfs:isDefinedBy rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/"/>
    <bibo:editor>
      <foaf:Person rdf:nodeID="nf3f48206b69e4087a80918a419389692b1">
        <owl:sameAs rdf:resource="https://orcid.org/0000-0003-1867-4428"/>
        <foaf:name>Daham Mustafa</foaf:name>
      </foaf:Person>
    </bibo:editor>
    <bibo:editor>
