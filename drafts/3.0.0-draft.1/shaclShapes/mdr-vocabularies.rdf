        <sh:path rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.org/dc/terms/spatial"/>
          <rdf:Description rdf:about="http://purl.org/dc/terms/identifier"/>
        </sh:path>
        <sh:qualifiedValueShape rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#SpatialRestriction"/>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The geographical coverage of the dataset, taken from the EU authority tables for Continent (http://publications.europa.eu/resource/authority/continent), Countries and territories (http://publications.europa.eu/resource/authority/country) or Place (http://publications.europa.eu/resource/authority/place), or from GeoNames. Use of these vocabularies is recommended; other values are tolerated.</sh:description>
    <sh:message xml:lang="en">spatial should include at least one value from the EU Continent, Country or Place tables, or from GeoNames.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Distribution_MobilityDataStandard_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b96">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#mobilityDataStandard"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b97">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#mobilityDataStandard"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#MobilityDataStandardRestriction">
            <rdfs:label xml:lang="en">MobilityDataStandardRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b22">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-data-standard"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">Values identify the mobility data standard adopted by the distribution, using the Mobility data standard controlled vocabulary (https://w3id.org/mobilitydcat-ap/mobility-data-standard). At least one value must come from this vocabulary; if no suitable standard is listed, use the 'other' value (https://w3id.org/mobilitydcat-ap/mobility-data-standard/other). Values outside the vocabulary are tolerated, for example a custom mobilitydcatap:MobilityDataStandard instance giving a version or a national profile.</sh:description>
    <sh:message xml:lang="en">mobilityDataStandard should include at least one concept from the Mobility data standard vocabulary; use 'other' if none applies.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Dataset_Publisher_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b76">
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b77">
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:qualifiedValueShape rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#CorporateBodyRestriction"/>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The entity responsible for publishing the dataset, referenced from the EU Corporate body authority table (http://publications.europa.eu/resource/authority/corporate-body). Use of this vocabulary is recommended; other values, such as a national organisation not listed there, are tolerated.</sh:description>
    <sh:message xml:lang="en">publisher should include at least one concept from the EU Corporate body table.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Distribution_ApplicationLayerProtocol_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b100">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#applicationLayerProtocol"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b101">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#applicationLayerProtocol"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ApplicationLayerProtocolRestriction">
            <rdfs:label xml:lang="en">ApplicationLayerProtocolRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b23">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="https://w3id.org/mobilitydcat-ap/application-layer-protocol"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">Values state the application layer protocol of the distribution, using the Application layer protocol controlled vocabulary (https://w3id.org/mobilitydcat-ap/application-layer-protocol). At least one value must come from this vocabulary; if none applies, use the 'other' value (https://w3id.org/mobilitydcat-ap/application-layer-protocol/other). Values outside the vocabulary are tolerated.</sh:description>
    <sh:message xml:lang="en">applicationLayerProtocol should include at least one concept from the Application layer protocol vocabulary; use 'other' if none applies.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#CountryRestriction">
    <rdfs:label xml:lang="en">CountryRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b15">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/country"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ContinentRestriction">
    <rdfs:label xml:lang="en">ContinentRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b14">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/continent"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#FileTypeRestriction">
    <rdfs:label xml:lang="en">FileTypeRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b7">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ReferenceSystemRestriction">
    <rdfs:label xml:lang="en">Reference System (EPSG) restriction</rdfs:label>
    <sh:pattern>^https?://(www\.opengis\.net/def/crs/EPSG/|epsg\.io/)</sh:pattern>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#PlaceRestriction">
    <rdfs:label xml:lang="en">PlaceRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b16">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/place"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#FrequencyRestriction">
    <rdfs:label xml:lang="en">FrequencyRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b6">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/frequency"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#DistributionStatusRestriction">
    <rdfs:label xml:lang="en">DistributionStatusRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b9">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/distribution-status"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#GeoNamesRestrictionRegexURI">
    <rdfs:label xml:lang="en">GeoNames restriction</rdfs:label>
    <sh:pattern>^https?://(sws\.)?geonames\.org</sh:pattern>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#LanguageRestriction">
    <rdfs:label xml:lang="en">LanguageRestriction</rdfs:label>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b8">
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/language"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
</rdf:RDF>
