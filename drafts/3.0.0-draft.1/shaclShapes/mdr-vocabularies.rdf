  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#DatasetSeries_Spatial_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#DatasetSeries"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b90">
        <sh:path rdf:resource="http://purl.org/dc/terms/spatial"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b91">
        <sh:path rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.org/dc/terms/spatial"/>
          <rdf:Description rdf:about="http://purl.org/dc/terms/identifier"/>
        </sh:path>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#SpatialRestriction">
            <rdfs:label xml:lang="en">Spatial restriction (EU tables or GeoNames)</rdfs:label>
            <sh:or rdf:parseType="Collection">
              <rdf:Description rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ContinentRestriction"/>
              <rdf:Description rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#CountryRestriction"/>
              <rdf:Description rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#PlaceRestriction"/>
              <rdf:Description rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#GeoNamesRestrictionRegexURI"/>
            </sh:or>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The geographical coverage of the dataset series, taken from the EU authority tables for Continent (http://publications.europa.eu/resource/authority/continent), Countries and territories (http://publications.europa.eu/resource/authority/country) or Place (http://publications.europa.eu/resource/authority/place), or from GeoNames. Use of these vocabularies is recommended; other values are tolerated.</sh:description>
    <sh:message xml:lang="en">spatial should include at least one value from the EU Continent, Country or Place tables, or from GeoNames.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Distribution_License_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b108">
        <sh:path rdf:resource="http://purl.org/dc/terms/license"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b109">
        <sh:path rdf:resource="http://purl.org/dc/terms/license"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#LicenceRestriction">
            <rdfs:label xml:lang="en">LicenceRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b13">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/licence"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The licence under which the distribution is made available, referencing a concrete standard licence from the EU Licence authority table (http://publications.europa.eu/resource/authority/licence). Use of this vocabulary is recommended; other values are tolerated.</sh:description>
    <sh:message xml:lang="en">license should include at least one concept from the EU Licence table.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Agent_PublisherType_CV">
    <sh:targetClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b112">
        <sh:path rdf:resource="http://purl.org/dc/terms/type"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b113">
        <sh:path rdf:resource="http://purl.org/dc/terms/type"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#PublisherTypeRestriction">
            <rdfs:label xml:lang="en">PublisherTypeRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b11">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="http://purl.org/adms/publishertype/1.0"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The type of the publishing organisation, taken from the ADMS Publisher Type vocabulary (http://purl.org/adms/publishertype/1.0), which distinguishes national, regional and local authorities, companies, academic and standardisation bodies and similar. Use of this vocabulary is recommended; other values are tolerated.</sh:description>
    <sh:message xml:lang="en">publisher type (dct:type) should include at least one concept from the ADMS Publisher Type vocabulary.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Dataset_Theme_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b56">
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#theme"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b57">
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#theme"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#DataThemeRestriction">
            <rdfs:label xml:lang="en">DataThemeRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b10">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/data-theme"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">Values categorise the dataset using the EU Data theme authority table (http://publications.europa.eu/resource/authority/data-theme). At least one value must come from this vocabulary. Values outside the vocabulary are tolerated.</sh:description>
    <sh:message xml:lang="en">dcat:theme should include at least one concept from the EU Data theme table.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Catalogue_Publisher_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b38">
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b39">
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#CorporateBodyRestriction">
            <rdfs:label xml:lang="en">CorporateBodyRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b12">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">The entity responsible for publishing the catalogue, referenced from the EU Corporate body authority table (http://publications.europa.eu/resource/authority/corporate-body). Use of this vocabulary is recommended; other values, such as a national organisation not listed there, are tolerated.</sh:description>
    <sh:message xml:lang="en">publisher should include at least one concept from the EU Corporate body table.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Dataset_TransportMode_CV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <sh:or rdf:parseType="Collection">
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b68">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#transportMode"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</sh:maxCount>
      </rdf:Description>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b69">
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#transportMode"/>
        <sh:qualifiedValueShape>
          <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#TransportModeRestriction">
            <rdfs:label xml:lang="en">TransportModeRestriction</rdfs:label>
            <sh:property>
              <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b18">
                <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <sh:hasValue rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
                <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
              </rdf:Description>
            </sh:property>
          </sh:NodeShape>
        </sh:qualifiedValueShape>
        <sh:qualifiedMinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:qualifiedMinCount>
      </rdf:Description>
    </sh:or>
    <sh:description xml:lang="en">Values state the transport modes covered by the dataset, using the Transport Mode controlled vocabulary (https://w3id.org/mobilitydcat-ap/transport-mode). At least one value must come from this vocabulary; if none applies, use the 'other' value (https://w3id.org/mobilitydcat-ap/transport-mode/other). Values outside the vocabulary are tolerated.</sh:description>
    <sh:message xml:lang="en">transportMode should include at least one concept from the Transport Mode vocabulary; use 'other' if none applies.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </sh:NodeShape>
