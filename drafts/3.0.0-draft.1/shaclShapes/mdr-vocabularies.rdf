  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Dataset_MobilityShapeCV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b32">
        <sh:path rdf:resource="http://purl.org/dc/terms/accrualPeriodicity"/>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#FrequencyRestriction"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="en">The update frequency of the delivered content, taken from the EU Frequency authority table (http://publications.europa.eu/resource/authority/frequency). The value space is closed: only concepts from this vocabulary are allowed.</sh:description>
        <sh:message xml:lang="en">accrualPeriodicity value must be a concept from the EU Frequency table.</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b33">
        <sh:path rdf:resource="http://purl.org/dc/terms/language"/>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#LanguageRestriction"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="en">The language of the textual metadata, taken from the EU Language authority table (http://publications.europa.eu/resource/authority/language). The value space is closed: only concepts from this vocabulary are allowed, and the value must be a URI rather than a literal code.</sh:description>
        <sh:message xml:lang="en">language value must be a concept from the EU Language table (skos:inScheme).</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b34">
        <sh:path rdf:resource="http://data.europa.eu/930/referenceSystem"/>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ReferenceSystemRestriction"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="en">The spatial reference system used in the dataset, identified by a coordinate reference system URI from the OGC EPSG register. This register is not a SKOS scheme, so membership is checked by URI pattern rather than skos:inScheme. The value space is closed: only EPSG URIs are allowed.</sh:description>
        <sh:message xml:lang="en">referenceSystem value must be an OGC EPSG coordinate reference system URI.</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Distribution_MobilityShapeCV">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b36">
        <sh:path rdf:resource="http://purl.org/dc/terms/format"/>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#FileTypeRestriction"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="en">The technical syntax of the delivered content, taken from the EU File type authority table (http://publications.europa.eu/resource/authority/file-type). The value space is closed: only concepts from this vocabulary are allowed.</sh:description>
        <sh:message xml:lang="en">format value must be a concept from the EU File Type table (skos:inScheme).</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="nf3f48206b69e4087a80918a419389692b37">
        <sh:path rdf:resource="http://www.w3.org/ns/adms#status"/>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#DistributionStatusRestriction"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="en">The status of the distribution in its maturity lifecycle, taken from the EU Distribution status authority table (http://publications.europa.eu/resource/authority/distribution-status). The value space is closed: only concepts from this vocabulary are allowed.</sh:description>
        <sh:message xml:lang="en">status value must be a concept from the EU Distribution status table.</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </rdf:Description>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#Dataset_GeoreferencingMethod_CV">
