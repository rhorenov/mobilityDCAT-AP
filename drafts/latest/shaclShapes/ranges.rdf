        <sh:path rdf:resource="http://www.w3.org/ns/org#memberOf"/>
        <sh:class rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <sh:name xml:lang="en">affiliation (range)</sh:name>
        <sh:message xml:lang="en">Affiliation must be an org:Organization instance</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
</rdf:RDF>
