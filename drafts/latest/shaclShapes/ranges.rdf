  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges#Agent_Shape_ranges">
    <sh:targetClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <sh:name xml:lang="en">Agent (mobilityDCAT-AP) - Range Constraints</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges#Agent_Shape_address_range">
        <sh:path rdf:resource="http://www.w3.org/ns/locn#address"/>
        <sh:class rdf:resource="http://www.w3.org/ns/locn#Address"/>
        <sh:name xml:lang="en">address (range)</sh:name>
        <sh:message xml:lang="en">Address must be a locn:Address instance</sh:message>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
