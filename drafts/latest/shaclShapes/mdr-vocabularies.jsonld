    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "Values state the transport modes covered by the dataset, using the Transport Mode controlled vocabulary (https://w3id.org/mobilitydcat-ap/transport-mode). At least one value must come from this vocabulary; if none applies, use the 'other' value (https://w3id.org/mobilitydcat-ap/transport-mode/other). Values outside the vocabulary are tolerated."
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "transportMode should include at least one concept from the Transport Mode vocabulary; use 'other' if none applies."
